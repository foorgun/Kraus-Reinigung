---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { faqs } from '@/content/faq';
import { site } from '@/config/site';
---

<section id="faq" class="scroll-mt-28 bg-ink-50 py-20 sm:py-28">
  <div class="container-page">
    <SectionHeading
      label="FAQ"
      headline="Häufige Fragen, kurz beantwortet"
      highlight="kurz beantwortet"
      text="Steht Ihre Frage nicht dabei? Rufen Sie einfach an – wir antworten direkt."
      class="max-w-2xl"
      data-reveal
    />

    <div class="mt-12 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,27rem)] lg:gap-12 lg:items-start">
      <!-- Akkordeon -->
      <div class="flex flex-col gap-3" data-reveal>
        {
          faqs.map((faq, i) => (
            <div
              class="faq-item overflow-hidden rounded-3xl border border-ink-100 bg-white transition-colors duration-300"
              data-faq-item={i}
            >
              <h3>
                <button
                  type="button"
                  class="faq-trigger flex w-full items-center justify-between gap-4 px-5 py-5 text-left sm:px-6"
                  aria-expanded={i === 0 ? 'true' : 'false'}
                  aria-controls={`faq-panel-${i}`}
                  id={`faq-trigger-${i}`}
                  data-faq-index={i}
                >
                  <span class="font-display text-[1.0625rem] font-bold leading-snug text-ink-900 sm:text-lg">
                    {faq.question}
                  </span>
                  <span class="faq-icon grid h-9 w-9 shrink-0 place-items-center rounded-full border border-ink-200 text-ink-600 transition duration-300">
                    <Icon name="plus" class="h-4 w-4" stroke={2.2} />
                  </span>
                </button>
              </h3>
              {/* Antwort direkt im Akkordeon – auf großen Bildschirmen steht sie
                  stattdessen in der hervorgehobenen Karte rechts. */}
              <div
                id={`faq-panel-${i}`}
                role="region"
                aria-labelledby={`faq-trigger-${i}`}
                class="faq-panel grid"
                data-open={i === 0 ? 'true' : 'false'}
              >
                <div class="overflow-hidden">
                  <p class="px-5 pb-5 text-[0.95rem] leading-relaxed text-ink-500 sm:px-6">
                    {faq.answer}
                  </p>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Hervorgehobene Antwort-Karte (ab Desktop) -->
      <div class="hidden lg:block">
        <div class="on-dark sticky top-28 rounded-4xl bg-navy-900 p-8 text-white shadow-lift">
          <span class="pill-label pill-label--dark">Antwort</span>
          <h3
            id="faq-answer-question"
            class="mt-5 font-display text-2xl font-bold leading-snug text-white"
          >
            {faqs[0]?.question}
          </h3>
          <p
            id="faq-answer-text"
            class="mt-4 text-[0.95rem] leading-relaxed text-white/70"
            aria-live="polite"
          >
            {faqs[0]?.answer}
          </p>

          <div class="mt-8 border-t border-white/10 pt-6">
            <p class="text-sm text-white/60">Frage nicht dabei?</p>
            <a
              href={site.phone.href}
              class="mt-3 inline-flex items-center gap-2 rounded-full bg-brand-500 px-5 py-3 text-[0.95rem] font-semibold text-white transition hover:bg-brand-600"
            >
              <Icon name="phone" class="h-[1.05em] w-[1.05em]" />
              {site.phone.display}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .faq-panel {
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .faq-panel[data-open='true'] {
    grid-template-rows: 1fr;
  }

  /* Ab Desktop wird die Antwort rechts in der Karte gezeigt,
     das Akkordeon bleibt geschlossen. */
  @media (min-width: 1024px) {
    .faq-panel {
      grid-template-rows: 0fr !important;
    }
  }

  .faq-item[data-active='true'] {
    border-color: var(--color-brand-300);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-panel {
      transition: none;
    }
  }
</style>

<script is:inline define:vars={{ faqData: faqs }}>
  (() => {
    const items = document.querySelectorAll('[data-faq-item]');
    const triggers = document.querySelectorAll('.faq-trigger');
    const answerQ = document.getElementById('faq-answer-question');
    const answerT = document.getElementById('faq-answer-text');

    const render = (openIndex) => {
      triggers.forEach((trigger) => {
        const i = Number(trigger.getAttribute('data-faq-index'));
        const isOpen = i === openIndex;
        const panel = document.getElementById('faq-panel-' + i);
        const icon = trigger.querySelector('.faq-icon');

        trigger.setAttribute('aria-expanded', String(isOpen));
        if (panel) panel.setAttribute('data-open', String(isOpen));
        if (icon) {
          icon.classList.toggle('bg-brand-500', isOpen);
          icon.classList.toggle('border-brand-500', isOpen);
          icon.classList.toggle('text-white', isOpen);
          icon.classList.toggle('rotate-45', isOpen);
        }
      });

      items.forEach((item) => {
        const i = Number(item.getAttribute('data-faq-item'));
        item.setAttribute('data-active', String(i === openIndex));
      });

      const entry = faqData[openIndex];
      if (entry && answerQ && answerT) {
        answerQ.textContent = entry.question;
        answerT.textContent = entry.answer;
      }
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const i = Number(trigger.getAttribute('data-faq-index'));
        const wasOpen = trigger.getAttribute('aria-expanded') === 'true';
        const isDesktop = window.matchMedia('(min-width: 1024px)').matches;
        // Auf Desktop bleibt immer eine Antwort sichtbar, auf Mobil darf zugeklappt werden.
        render(wasOpen && !isDesktop ? -1 : i);
      });
    });

    render(0);
  })();
</script>
