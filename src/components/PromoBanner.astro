---
import Icon from './Icon.astro';
import { promo, isPromoActive, promoEndFormatted } from '@/config/promo';

/**
 * Aktions-Banner.
 * Wird zur Build-Zeit ausgewertet: Läuft die Aktion nicht (mehr), wird das
 * Banner gar nicht erst ausgegeben. Kein Countdown, der sich bei jedem
 * Seitenaufruf zurücksetzt.
 *
 * Hinweis: Die Seite ist statisch generiert. Nach dem Enddatum muss einmal
 * neu gebaut werden (bei Netlify/Vercel z. B. per Deploy-Hook), damit das
 * Banner verschwindet.
 */
const active = isPromoActive();
const endDate = promoEndFormatted();
---

{
  active && (
    <section aria-labelledby="aktion-titel" class="py-6 sm:py-10">
      <div class="container-page">
        <div
          class="on-dark relative overflow-hidden rounded-4xl bg-brand-500 px-6 py-8 text-white sm:px-10 sm:py-10"
          data-reveal
        >
          <div
            aria-hidden="true"
            class="absolute -right-16 -top-20 h-64 w-64 rounded-full bg-white/10"
          />
          <div
            aria-hidden="true"
            class="absolute -bottom-24 right-24 h-56 w-56 rounded-full bg-white/[0.07]"
          />

          <div class="relative flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
            <div class="max-w-2xl">
              <span class="inline-flex items-center gap-2 rounded-full bg-white/20 px-3.5 py-1.5 text-xs font-bold uppercase tracking-wider">
                <Icon name="bolt" class="h-3.5 w-3.5" />
                {promo.eyebrow}
              </span>
              <h2
                id="aktion-titel"
                class="mt-4 font-display text-[1.75rem] font-extrabold leading-tight text-white sm:text-4xl"
              >
                {promo.headline}
              </h2>
              <p class="mt-3 text-[0.95rem] leading-relaxed text-white/85 sm:text-base">
                {promo.text}
              </p>
              {endDate && (
                <p class="mt-3 text-sm font-semibold text-white/80">
                  Aktion läuft bis {endDate}
                </p>
              )}
            </div>

            <a
              href={promo.ctaHref}
              class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-white px-7 py-4 font-semibold text-brand-700 shadow-pill transition duration-300 hover:-translate-y-0.5 hover:bg-ink-50"
            >
              {promo.ctaLabel}
              <Icon name="arrow-up-right" class="h-[1.05em] w-[1.05em]" />
            </a>
          </div>

          {promo.finePrint && (
            <p class="relative mt-6 border-t border-white/20 pt-4 text-xs leading-relaxed text-white/65">
              {promo.finePrint}
            </p>
          )}
        </div>
      </div>
    </section>
  )
}
