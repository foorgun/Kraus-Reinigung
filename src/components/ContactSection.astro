---
import SectionHeading from './SectionHeading.astro';
import ContactForm from './ContactForm.astro';
import Icon from './Icon.astro';
import { site } from '@/config/site';
import { contactSection } from '@/content/home';
---

<section id="kontakt" class="scroll-mt-28 py-20 sm:py-28">
  <div class="container-page">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,23rem)_minmax(0,1fr)] lg:gap-14">
      <!-- Kontaktinfos -->
      <div class="flex flex-col gap-6">
        <SectionHeading
          label={contactSection.label}
          headline={contactSection.headline}
          highlight="wir melden uns"
          text={contactSection.text}
          data-reveal
        />

        <div class="flex flex-col gap-3" data-reveal style="--reveal-delay: 80ms">
          <a
            href={site.phone.href}
            class="group flex items-center gap-4 rounded-3xl border border-ink-100 bg-white p-5 shadow-soft transition hover:border-brand-300 hover:shadow-lift"
          >
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-brand-500 text-white">
              <Icon name="phone" class="h-5 w-5" />
            </span>
            <span>
              <span class="block text-sm text-ink-400">Direkt anrufen</span>
              <span class="block font-display text-lg font-bold text-ink-900">
                {site.phone.display}
              </span>
            </span>
          </a>

          <a
            href={`mailto:${site.email}`}
            class="group flex items-center gap-4 rounded-3xl border border-ink-100 bg-white p-5 shadow-soft transition hover:border-brand-300 hover:shadow-lift"
          >
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-ink-50 text-brand-600">
              <Icon name="mail" class="h-5 w-5" />
            </span>
            <span class="min-w-0">
              <span class="block text-sm text-ink-400">E-Mail schreiben</span>
              {/* [PRÜFEN] Platzhalter-Adresse – echte E-Mail vom Kunden eintragen */}
              <span class="block truncate font-display text-lg font-bold text-ink-900">
                {site.email}
              </span>
            </span>
          </a>

          <div class="flex items-start gap-4 rounded-3xl border border-ink-100 bg-white p-5 shadow-soft">
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-ink-50 text-brand-600">
              <Icon name="map-pin" class="h-5 w-5" />
            </span>
            <span>
              <span class="block text-sm text-ink-400">Anschrift</span>
              <address class="not-italic font-display text-lg font-bold leading-snug text-ink-900">
                {site.address.street}<br />
                {site.address.postalCode} {site.address.city}
              </address>
              <span class="mt-1 block text-sm text-ink-500">
                {site.tagline}
              </span>
            </span>
          </div>

          <div class="flex items-start gap-4 rounded-3xl border border-ink-100 bg-white p-5 shadow-soft">
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-ink-50 text-brand-600">
              <Icon name="clock" class="h-5 w-5" />
            </span>
            <span class="flex-1">
              <span class="block text-sm text-ink-400">Öffnungszeiten</span>
              <ul class="mt-1 flex flex-col gap-1">
                {
                  site.openingHours.map((row) => (
                    <li class="flex items-baseline justify-between gap-4 text-[0.95rem]">
                      <span class="whitespace-nowrap text-ink-600">{row.days}</span>
                      <span class="shrink-0 whitespace-nowrap font-semibold text-ink-900">{row.time}</span>
                    </li>
                  ))
                }
              </ul>
            </span>
          </div>
        </div>

        <p
          class="flex items-start gap-3 rounded-3xl bg-brand-50 px-5 py-4 text-sm leading-relaxed text-brand-800"
        >
          <Icon name="check" class="mt-0.5 h-[18px] w-[18px] shrink-0" stroke={2.4} />
          <span>
            Im Umkreis von {site.consultationRadiusKm} km beraten wir Sie kostenlos
            vor Ort – inklusive kostenloser Probeflächenreinigung.
          </span>
        </p>
      </div>

      <!-- Formular -->
      <div
        class="rounded-4xl border border-ink-100 bg-white p-6 shadow-soft sm:p-8 lg:p-10"
        data-reveal
        style="--reveal-delay: 120ms"
      >
        <h3 class="font-display text-xl font-bold text-ink-900 sm:text-2xl">
          Unverbindlich anfragen
        </h3>
        <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-500">
          Je mehr wir vorab wissen, desto genauer können wir Sie beraten.
        </p>
        <div class="mt-7">
          <ContactForm />
        </div>
      </div>
    </div>
  </div>
</section>
