---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { method } from '@/content/home';
---

<section id="verfahren" class="on-dark scroll-mt-28 bg-navy-900 py-20 text-white sm:py-28">
  <div class="container-page">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center lg:gap-16">
      <div>
        <SectionHeading
          label={method.label}
          headline={method.headline}
          highlight="Sauber"
          text={method.text}
          dark
          data-reveal
        />

        <ul class="mt-10 grid gap-x-6 gap-y-5 sm:grid-cols-2">
          {
            method.points.map((point, i) => (
              <li
                class="flex gap-3"
                data-reveal
                style={`--reveal-delay: ${i * 60}ms`}
              >
                <span class="mt-0.5 grid h-7 w-7 shrink-0 place-items-center rounded-full bg-brand-500/20 text-brand-300">
                  <Icon name="check" class="h-4 w-4" stroke={2.4} />
                </span>
                <span>
                  <span class="block font-display text-[1.0625rem] font-bold text-white">
                    {point.title}
                  </span>
                  <span class="mt-1 block text-sm leading-relaxed text-white/60">
                    {point.text}
                  </span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="relative" data-reveal style="--reveal-delay: 120ms">
        <img
          src={method.image.src}
          alt={method.image.alt}
          width="900"
          height="1000"
          loading="lazy"
          decoding="async"
          class="aspect-[4/5] w-full rounded-5xl object-cover shadow-lift"
        />
        <!--
          Dunkel hinterlegt statt nur milchig: Der Kasten liegt direkt auf dem
          Foto, ohne dunkles Overlay darunter. Über hellen Bildstellen (nasser
          Stein, Himmel) käme weiße Schrift auf weiß-transparentem Grund sonst
          auf ~1,1:1. Mit navy-950/80 sind es auch im ungünstigsten Fall 7,9:1.
        -->
        <div
          class="glass-card absolute -bottom-5 left-5 right-5 rounded-3xl bg-navy-950/80 p-5 sm:left-8 sm:right-auto sm:max-w-xs"
        >
          <p class="flex items-start gap-3 text-sm leading-relaxed text-white/85">
            <Icon name="leaf" class="mt-0.5 h-5 w-5 shrink-0 text-brand-300" />
            <span>
              Biologisch abbaubare Reinigungsmittel – schonend zu Pflanzen und
              Umgebung.
            </span>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
