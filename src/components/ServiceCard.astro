---
import Icon from './Icon.astro';
import type { ServiceCategory } from '@/content/services';

interface Props {
  category: ServiceCategory;
  index?: number;
  /**
   * Überschriftenebene der Karte. Standard ist h3 (Karten stehen unter einer
   * Sektions-h2). Auf Seiten, wo die Karten direkt unter der h1 stehen,
   * `as="h2"` setzen, damit die Überschriftenhierarchie lückenlos bleibt.
   */
  as?: 'h2' | 'h3';
}

const { category, index = 0, as: Heading = 'h3' } = Astro.props;
---

<article
  class="group relative flex flex-col overflow-hidden rounded-4xl border border-ink-100 bg-white shadow-soft hover-lift"
  data-reveal
  style={`--reveal-delay: ${index * 80}ms`}
>
  <div class="relative aspect-[16/11] overflow-hidden bg-ink-100">
    <img
      src={category.image}
      alt={category.imageAlt}
      width="800"
      height="550"
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition duration-700 ease-out group-hover:scale-[1.04]"
    />
    <span
      class="absolute left-4 top-4 inline-flex items-center gap-2 rounded-full bg-white/90 px-3 py-1.5 text-xs font-semibold text-ink-700 backdrop-blur"
    >
      <Icon name={category.icon} class="h-4 w-4 text-brand-500" />
      {category.shortTitle}
    </span>
  </div>

  <div class="flex flex-1 flex-col gap-3 p-6 pb-20 sm:p-7 sm:pb-20">
    <Heading class="font-display text-xl font-bold text-ink-900 sm:text-[1.375rem]">
      <a href={category.href} class="after:absolute after:inset-0 after:content-['']">
        {category.title}
      </a>
    </Heading>
    <p class="text-[0.95rem] leading-relaxed text-ink-500">{category.teaser}</p>

    <ul class="mt-1 flex flex-wrap gap-1.5">
      {
        category.services.slice(0, 3).map((s) => (
          <li class="rounded-full bg-ink-50 px-2.5 py-1 text-xs font-medium text-ink-600">
            {s.name}
          </li>
        ))
      }
      {
        category.services.length > 3 && (
          <li class="rounded-full bg-ink-50 px-2.5 py-1 text-xs font-medium text-ink-500">
            +{category.services.length - 3} weitere
          </li>
        )
      }
    </ul>
  </div>

  <span class="arrow-button absolute bottom-6 right-6" aria-hidden="true">
    <Icon name="arrow-up-right" class="h-5 w-5" stroke={2} />
  </span>
</article>
