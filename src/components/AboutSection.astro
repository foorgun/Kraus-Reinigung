---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { about } from '@/content/home';

/**
 * Statement-Text: wird in Wörter zerlegt, damit sich die Farbe beim Scrollen
 * Wort für Wort von grau nach schwarz füllt.
 * Wörter in {geschweiften Klammern} werden grün hervorgehoben.
 */
let inHighlight = false;
const words = about.statement.split(/\s+/).map((raw) => {
  if (raw.includes('{')) inHighlight = true;
  const accent = inHighlight;
  if (raw.includes('}')) inHighlight = false;
  return { text: raw.replace(/[{}]/g, ''), accent };
});
---

<section id="ueber-uns" class="scroll-mt-28 py-20 sm:py-28">
  <div class="container-page">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-16">
      <!-- Linke Spalte: USPs -->
      <div class="flex flex-col gap-6">
        <SectionHeading label={about.label} headline={about.headline} data-reveal />

        <ul class="mt-2 flex flex-col gap-3">
          {
            about.facts.map((fact, i) => (
              <li
                class="rounded-3xl border border-ink-100 bg-white p-5 shadow-soft hover-lift"
                data-reveal
                style={`--reveal-delay: ${i * 70}ms`}
              >
                <div class="flex items-baseline gap-2.5">
                  <span class="font-display text-2xl font-extrabold text-brand-500">
                    {fact.value}
                  </span>
                  <span class="font-display text-sm font-bold text-ink-900">
                    {fact.label}
                  </span>
                </div>
                <p class="mt-1.5 text-sm leading-snug text-ink-500">{fact.text}</p>
              </li>
            ))
          }
        </ul>

        <a
          href="/#kontakt"
          class="group inline-flex items-center gap-2 self-start text-[0.95rem] font-semibold text-brand-600 transition hover:text-brand-700"
        >
          Kostenlose Beratung anfragen
          <Icon
            name="arrow-right"
            class="h-4 w-4 transition group-hover:translate-x-1"
          />
        </a>
      </div>

      <!-- Rechte Spalte: Statement mit Scroll-Reveal -->
      <div class="lg:pt-6">
        <p
          id="about-statement"
          class="font-display text-[1.6rem] font-bold leading-[1.35] tracking-tight sm:text-[2.1rem] lg:text-[2.6rem] lg:leading-[1.3]"
        >
          {
            words.map((w) => (
              <>
                <span class={`scroll-fill-word${w.accent ? ' accent' : ''}`}>
                  {w.text}
                </span>{' '}
              </>
            ))
          }
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  // Statement-Text: Wörter färben sich nacheinander ein, während die Sektion
  // durch den Viewport wandert.
  const statement = document.getElementById('about-statement');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (statement) {
    const words = Array.from(
      statement.querySelectorAll<HTMLElement>('.scroll-fill-word')
    );

    if (reduced) {
      words.forEach((w) => w.classList.add('is-filled'));
    } else {
      let ticking = false;

      const update = () => {
        ticking = false;
        const rect = statement.getBoundingClientRect();
        const vh = window.innerHeight;

        // 0 = Text betritt das untere Viewport-Drittel, 1 = Text ist oben durch
        const startAt = vh * 0.85;
        const endAt = vh * 0.3;
        const raw = (startAt - rect.top) / (startAt - endAt + rect.height * 0.6);
        const progress = Math.min(1, Math.max(0, raw));
        const filled = Math.round(progress * words.length);

        words.forEach((word, i) => {
          word.classList.toggle('is-filled', i < filled);
        });
      };

      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();
    }
  }
</script>
