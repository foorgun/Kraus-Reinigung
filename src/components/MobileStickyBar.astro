---
import Icon from './Icon.astro';
import { site } from '@/config/site';
---

<!--
  Permanente Aktionsleiste auf Mobilgeräten.
  Die meisten Besucher kommen vom Handy – Anrufen und Anfragen sind
  dadurch immer einen Daumen entfernt.
-->
<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-ink-100 bg-white/95 px-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-3 backdrop-blur-lg lg:hidden"
>
  <div class="flex gap-2.5">
    <a
      href={site.phone.href}
      class="flex flex-1 items-center justify-center gap-2 rounded-full bg-brand-500 px-4 py-3.5 text-[0.95rem] font-semibold text-white"
    >
      <Icon name="phone" class="h-[18px] w-[18px]" />
      Jetzt anrufen
    </a>
    <a
      href="/#kontakt"
      class="flex flex-1 items-center justify-center gap-2 rounded-full border border-ink-200 bg-white px-4 py-3.5 text-[0.95rem] font-semibold text-ink-900"
    >
      <Icon name="mail" class="h-[18px] w-[18px] text-brand-500" />
      Anfrage
    </a>
  </div>
</div>

<!-- Platz, damit die Leiste nichts überdeckt -->
<div aria-hidden="true" class="h-[4.75rem] lg:hidden"></div>
