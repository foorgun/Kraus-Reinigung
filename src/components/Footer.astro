---
import Icon from './Icon.astro';
import { site, footerLegal } from '@/config/site';
import { serviceCategories } from '@/content/services';
import { features } from '@/config/features';

const year = new Date().getFullYear();
---

<footer class="on-dark mt-24 bg-navy-950 text-white sm:mt-32">
  <div class="container-page py-16 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.3fr_1fr_1fr] lg:gap-16">
      <!-- Marke + Kontakt -->
      <div>
        <img
          src="/logo-invers.svg"
          alt={site.name}
          width="160"
          height="40"
          class="h-9 w-auto"
          loading="lazy"
        />
        <p class="mt-5 max-w-sm text-[0.95rem] leading-relaxed text-white/60">
          Handwerks- und Reinigungsbetrieb aus {site.address.city}. Dachreinigung,
          Fassadenreinigung, Steinreinigung, Sanierung und Pflasterarbeiten –{' '}
          {site.tagline.toLowerCase()}.
        </p>

        <address class="mt-7 flex flex-col gap-3 not-italic text-[0.95rem]">
          <a
            href={site.phone.href}
            class="inline-flex items-center gap-3 font-semibold text-white transition hover:text-brand-300"
          >
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-brand-500/20 text-brand-300">
              <Icon name="phone" class="h-4 w-4" />
            </span>
            {site.phone.display}
          </a>
          <a
            href={`mailto:${site.email}`}
            class="inline-flex items-center gap-3 text-white/70 transition hover:text-brand-300"
          >
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-white/10 text-white/70">
              <Icon name="mail" class="h-4 w-4" />
            </span>
            {/* [PRÜFEN] Platzhalter-E-Mail – echte Adresse vom Kunden */}
            {site.email}
          </a>
          <span class="inline-flex items-center gap-3 text-white/70">
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-white/10 text-white/70">
              <Icon name="map-pin" class="h-4 w-4" />
            </span>
            <span>
              {site.address.street}, {site.address.postalCode} {site.address.city}
            </span>
          </span>
        </address>
      </div>

      <!-- Leistungen -->
      <nav aria-labelledby="footer-leistungen">
        <h2 id="footer-leistungen" class="font-display text-sm font-bold uppercase tracking-wider text-white/60">
          Leistungen
        </h2>
        <ul class="mt-5 flex flex-col gap-3 text-[0.95rem]">
          {
            serviceCategories.map((cat) => (
              <li>
                <a href={cat.href} class="text-white/70 transition hover:text-brand-300">
                  {cat.title}
                </a>
              </li>
            ))
          }
          {
            features.showBeforeAfter && (
              <li>
                <a href="/#vorher-nachher" class="text-white/70 transition hover:text-brand-300">
                  Vorher / Nachher
                </a>
              </li>
            )
          }
          <li>
            <a href="/#faq" class="text-white/70 transition hover:text-brand-300">
              Häufige Fragen
            </a>
          </li>
        </ul>
      </nav>

      <!-- Öffnungszeiten -->
      <div>
        <h2 class="font-display text-sm font-bold uppercase tracking-wider text-white/60">
          Öffnungszeiten
        </h2>
        <ul class="mt-5 flex flex-col gap-3 text-[0.95rem]">
          {
            site.openingHours.map((row) => (
              <li class="flex items-start justify-between gap-4 border-b border-white/10 pb-3">
                <span class="text-white/70">{row.days}</span>
                <span class="shrink-0 font-semibold text-white">{row.time}</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-5 inline-flex items-start gap-2 text-sm text-white/60">
          <Icon name="clock" class="mt-0.5 h-4 w-4 shrink-0 text-brand-300" />
          Wir kommen, wann Sie können – Termine auch außerhalb der Bürozeiten nach Absprache.
        </p>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col-reverse gap-5 border-t border-white/10 pt-8 text-sm text-white/60 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {site.name}. Alle Rechte vorbehalten.</p>
      <nav aria-label="Rechtliches">
        <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
          {
            footerLegal.map((item) => (
              <li>
                <a href={item.href} class="transition hover:text-white">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</footer>
