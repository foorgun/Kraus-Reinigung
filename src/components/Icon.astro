---
/**
 * Inline-SVG-Icons (kein externer Icon-Font, keine CDN-Abhängigkeit).
 * Icons sind rein dekorativ und daher aria-hidden.
 */
export type IconName =
  | 'arrow-up-right'
  | 'arrow-right'
  | 'phone'
  | 'mail'
  | 'map-pin'
  | 'clock'
  | 'calendar'
  | 'bolt'
  | 'droplet'
  | 'check'
  | 'shield'
  | 'leaf'
  | 'spray'
  | 'roof'
  | 'brush'
  | 'garden'
  | 'plus'
  | 'menu'
  | 'close'
  | 'chevron-down'
  | 'sliders';

interface Props {
  name: IconName;
  class?: string;
  /** Strichstärke, Standard 1.75 */
  stroke?: number;
}

const { name, class: className = 'w-5 h-5', stroke = 1.75 } = Astro.props;

const paths: Record<IconName, string> = {
  'arrow-up-right': '<path d="M7 17 17 7M9 7h8v8"/>',
  'arrow-right': '<path d="M5 12h14M13 6l6 6-6 6"/>',
  phone:
    '<path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5L16 12l4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 3 6.2 2 2 0 0 1 5 4h1.5Z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m3.5 7 7.4 5.2a2 2 0 0 0 2.2 0L20.5 7"/>',
  'map-pin':
    '<path d="M12 21s7-5.7 7-11a7 7 0 1 0-14 0c0 5.3 7 11 7 11Z"/><circle cx="12" cy="10" r="2.6"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3 2"/>',
  calendar:
    '<rect x="3" y="5" width="18" height="16" rx="2.5"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  bolt: '<path d="M13 2 4.5 13H11l-1 9 8.5-11H12l1-9Z"/>',
  droplet: '<path d="M12 3s6 6.2 6 10.2A6 6 0 0 1 6 13.2C6 9.2 12 3 12 3Z"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  shield:
    '<path d="M12 3 5 6v5.5c0 4.4 3 8 7 9.5 4-1.5 7-5.1 7-9.5V6l-7-3Z"/><path d="m9 12 2 2 4-4"/>',
  leaf: '<path d="M4 20c0-8 5-13 16-14 0 11-5 15-11 15-2.8 0-5-1-5-1Z"/><path d="M9 15c2-3 4.5-5 8-6.5"/>',
  spray:
    '<path d="M8 8h7a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2Z"/><path d="M10 8V4h3M17 5h2M17 9h2M17 13h2"/>',
  roof: '<path d="m2.5 11 9.5-7 9.5 7"/><path d="M5.5 9.2V20h13V9.2"/><path d="M9.5 20v-5.5h5V20"/>',
  brush:
    '<path d="M5 14.5V6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v8.5H5Z"/><path d="M10 14.5V18a2 2 0 0 0 4 0v-3.5"/><path d="M12 20v1.5"/>',
  garden:
    '<path d="M12 21v-7"/><path d="M12 14c-4 0-6.5-2.4-6.5-6.5C9.5 7.5 12 10 12 14Z"/><path d="M12 14c4 0 6.5-2.4 6.5-6.5C14.5 7.5 12 10 12 14Z"/><path d="M4 21h16"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  'chevron-down': '<path d="m6 9.5 6 6 6-6"/>',
  sliders: '<path d="M12 3v18"/><path d="m8 9-3 3 3 3M16 9l3 3-3 3"/>',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
